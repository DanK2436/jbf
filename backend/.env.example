# Copier vers backend/.env et renseigner depuis Supabase Dashboard → Project Settings → API / Database

SUPABASE_URL=https://VOTRE_REF.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Mot de passe PostgreSQL (Settings → Database → Database password)
SUPABASE_DB_PASSWORD=

# Optionnel : URL pooler complète (prioritaire sur SUPABASE_DB_PASSWORD)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[PWD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

BREVO_API_KEY=
RESEND_API_KEY=
ADMIN_OFFICIAL_EMAIL=services@admin.jbf
# Vide ou absent : la connexion admin locale est refusée (fail-closed). Ne pas remettre de mot de passe d'exemple.
ADMIN_OFFICIAL_PASSWORD=
